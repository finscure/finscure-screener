rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══ ADMIN CONFIG ═══
    // Admin UIDs stored in platform_config/admin doc
    // Admins can read all data across all collections
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/platform_config/admin) &&
        request.auth.uid in get(/databases/$(database)/documents/platform_config/admin).data.uids;
    }

    // ═══ PLATFORM CONFIG ═══
    // Only admins can read/write config
    match /platform_config/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ═══ USERS ═══
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if isAdmin();
    }

    // ═══ PROGRESS ═══
    match /progress/{docId} {
      allow read, write: if request.auth != null && docId.matches(request.auth.uid + '_.*');
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
    }

    // ═══ MOCK PORTFOLIOS ═══
    match /mock_portfolios/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if isAdmin();
    }

    // ═══ MOCK TRANSACTIONS ═══
    match /mock_transactions/{docId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
    }

    // ═══ MOCK PENDING ORDERS ═══
    match /mock_pending_orders/{docId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
    }

    // ═══ MOCK WATCHLISTS ═══
    match /mock_watchlists/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if isAdmin();
    }

    // ═══ DENY EVERYTHING ELSE ═══
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
